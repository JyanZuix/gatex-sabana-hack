# Copiar como `.env` (no se sube al repositorio) y completar.
# simulado = datos sintéticos de backend/datos_sinteticos; postgres = base real (Supabase)
REPOSITORIO=postgres
# Supabase → Connect → Session pooler. Codificar símbolos de la contraseña (@ → %40).
DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres?sslmode=require
